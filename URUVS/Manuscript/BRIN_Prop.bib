@article{yamamotoLivingEcosystemDegradation2023,
  title = {Living under Ecosystem Degradation: {{Evidence}} from the Mangrove--Fishery Linkage in {{Indonesia}}},
  shorttitle = {Living under Ecosystem Degradation},
  author = {Yamamoto, Yuki},
  year = 2023,
  month = mar,
  journal = {Journal of Environmental Economics and Management},
  volume = {118},
  pages = {102788},
  issn = {00950696},
  doi = {10.1016/j.jeem.2023.102788},
  urldate = {2023-06-15},
  abstract = {This study examines the impacts of ecosystem degradation on social welfare, focusing on the mangrove--fishery linkage in Indonesia. Using nationally representative household data combined with satellite information on spatiotemporal mangrove loss, the study finds that fishery households experienced a decline in annual income ranging from 5.3\% to 9.8\% in response to a 1\% increase in mangrove loss in the region. Under the income shock, fishery households increased their labor input and decreased their non-food consumption; however, they continued being part of the fishery industry. Furthermore, according to a back-ofthe-envelope calculation, the potential economic value of mangrove conservation, estimated in terms of fishery production reached 22,861 US\$/hectare/year. This makes conservation substantially more cost-effective than alternative land uses, such as aquaculture and oil palm plantations. These findings highlight the need to support mangrove forest conservation to achieve sustainable development and ecosystem conservation.},
  langid = {english},
  file = {C:\Users\swulfing\Zotero\storage\682822EU\Yamamoto - 2023 - Living under ecosystem degradation Evidence from .pdf}
}

@article{zuermgassenMangrovesSupportEstimated2025,
  title = {Mangroves Support an Estimated Annual Abundance of over 700 Billion Juvenile Fish and Invertebrates},
  author = {Zu Ermgassen, Philine S. E. and Worthington, Thomas A. and Gair, Jonathan R. and Garnett, Emma E. and Mukherjee, Nibedita and {Longley-Wood}, Kate and Nagelkerken, Ivan and Abrantes, K{\'a}tya and {Aburto-Oropeza}, Octavio and Acosta, Alejandro and Araujo, Ana Rosa Da Rocha and Baker, Ronald and Barnett, Adam and Beitl, Christine M. and Benzeev, Rayna and Brookes, Justin and {Castellanos-Galindo}, Gustavo A. and Ching Chong, Ving and Connolly, Rod M. and {Cunha-Lignon}, Mar{\'i}lia and {Dahdouh-Guebas}, Farid and Diele, Karen and Dwyer, Patrick G. and Friess, Daniel A. and Grove, Thomas and Hoq, M. Enamul and Huijbers, Chantal and Hutchinson, Neil and Johnson, Andrew F. and Johnson, Ross and Knight, Jon and Krumme, Uwe and Kuguru, Baraka and Lee, Shing Yip and Lobo, Aaron Savio and Lugendo, Blandina R. and Meynecke, Jan-Olaf and Munga, Cosmas Nzaka and Olds, Andrew D. and Parrett, Cara L. and Reguero, Borja G. and R{\"o}nnb{\"a}ck, Patrik and Safryghin, Anna and Sheaves, Marcus and Taylor, Matthew D. and Mendon{\c c}a, Jocemar Tomasino and Waltham, Nathan J. and Wolff, Matthias and Spalding, Mark D.},
  year = 2025,
  month = apr,
  journal = {Communications Earth \& Environment},
  volume = {6},
  number = {1},
  pages = {299},
  issn = {2662-4435},
  doi = {10.1038/s43247-025-02229-w},
  urldate = {2026-08-21},
  abstract = {Abstract             Mangroves are a critical habitat that provide a suite of ecosystem services and support livelihoods. Here we undertook a global analysis to model the density and abundance of 37 commercially important juvenile fish and juvenile and resident invertebrates that are known to extensively use mangroves, by fitting expert-identified drivers of density to fish and invertebrate density data from published field studies. The numerical model predicted high densities throughout parts of Southeast and South Asia, the northern coast of South America, the Red Sea, and the Caribbean and Central America. Application of our model globally estimates that mangroves support an annual abundance of over 700 billion juvenile fish and invertebrates. While abundance at the early life-history stage does not directly equate to potential economic or biomass gains, this estimate indicates the critical role of mangroves globally in supporting fish and fisheries, and further builds the case for their conservation and restoration.},
  langid = {english},
  file = {C:\Users\swulfing\Zotero\storage\WE53RGGS\Zu Ermgassen et al. - 2025 - Mangroves support an estimated annual abundance of over 700 billion juvenile fish and invertebrates.pdf}
}

@article{zuermgassenReprintFishersWho2021,
  title = {Reprint of : {{Fishers}} Who Rely on Mangroves: {{Modelling}} and Mapping the Global Intensity of Mangrove-Associated Fisheries},
  shorttitle = {Reprint Of},
  author = {Zu Ermgassen, Philine S.E. and Mukherjee, Nibedita and Worthington, Thomas A. and Acosta, Alejandro and Rocha Araujo, Ana Rosa Da and Beitl, Christine M. and {Castellanos-Galindo}, Gustavo A. and {Cunha-Lignon}, Mar{\'i}lia and {Dahdouh-Guebas}, Farid and Diele, Karen and Parrett, Cara L. and Dwyer, Patrick G. and Gair, Jonathan R. and Johnson, Andrew Frederick and Kuguru, Baraka and Savio Lobo, Aaron and Loneragan, Neil R. and {Longley-Wood}, Kate and Mendon{\c c}a, Jocemar Tomasino and Meynecke, Jan-Olaf and Mandal, Roland Nathan and Munga, Cosmas Nzaka and Reguero, Borja G. and R{\"o}nnb{\"a}ck, Patrik and Thorley, Julia and Wolff, Matthias and Spalding, Mark},
  year = 2021,
  month = jan,
  journal = {Estuarine, Coastal and Shelf Science},
  volume = {248},
  pages = {107159},
  issn = {02727714},
  doi = {10.1016/j.ecss.2020.107159},
  urldate = {2024-02-13},
  abstract = {Mangroves are critical nursery habitats for fish and invertebrates, providing livelihoods for many coastal communities. Despite their importance, there is currently no estimate of the number of fishers engaged in mangrove associated fisheries, nor of the fishing intensity associated with mangroves at a global scale. We address these gaps by developing a global model of mangrove associated fisher numbers and mangrove fishing intensity. To develop the model, we undertook a three-round Delphi process with mangrove fisheries experts to identify the key drivers of mangrove fishing intensity. We then developed a conceptual model of intensity of mangrove fishing using those factors identified both as being important and for which appropriate global data could be found or developed. These factors were non-urban population, distance to market, distance to mangroves and other fishing grounds, and storm events. By projecting this conceptual model using geospatial data\- sets, we were able to estimate the number and distribution of mangrove associated fishers and the intensity of fishing in mangroves. We estimate there are 4.1 million mangrove associated fishers globally, with the highest number of mangrove fishers found in Indonesia, India, Bangladesh, Myanmar, and Brazil. Mangrove fishing intensity was greatest throughout Asia, and to a lesser extent West and Central Africa, and Central and South America.},
  langid = {english},
  file = {C:\Users\swulfing\Zotero\storage\6MNFSCHT\Zu Ermgassen et al. - 2021 - Reprint of  Fishers who rely on mangroves Modell.pdf}
}
